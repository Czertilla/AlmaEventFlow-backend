{
  "components": {
    "schemas": {
      "ClientCreate": {
        "properties": {
          "endpoint": {
            "maxLength": 512,
            "title": "Endpoint",
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "payload": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Transport-specific data. Web-push: p256dh, auth.",
            "title": "Payload",
            "type": "object"
          },
          "transport": {
            "$ref": "#/components/schemas/TransportTypeEnum",
            "default": "webpush"
          }
        },
        "required": [
          "endpoint"
        ],
        "title": "ClientCreate",
        "type": "object"
      },
      "ClientRead": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "endpoint": {
            "title": "Endpoint",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "transport": {
            "$ref": "#/components/schemas/TransportTypeEnum"
          }
        },
        "required": [
          "id",
          "transport",
          "endpoint",
          "is_active",
          "created_at"
        ],
        "title": "ClientRead",
        "type": "object"
      },
      "ErrorModel": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              }
            ],
            "title": "Detail"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorModel",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PreferenceItem": {
        "properties": {
          "is_enabled": {
            "title": "Is Enabled",
            "type": "boolean"
          },
          "transport": {
            "$ref": "#/components/schemas/TransportTypeEnum"
          }
        },
        "required": [
          "transport",
          "is_enabled"
        ],
        "title": "PreferenceItem",
        "type": "object"
      },
      "PreferencesRead": {
        "properties": {
          "preferences": {
            "items": {
              "$ref": "#/components/schemas/PreferenceItem"
            },
            "title": "Preferences",
            "type": "array"
          }
        },
        "required": [
          "preferences"
        ],
        "title": "PreferencesRead",
        "type": "object"
      },
      "PreferencesUpdate": {
        "properties": {
          "preferences": {
            "items": {
              "$ref": "#/components/schemas/PreferenceItem"
            },
            "minItems": 1,
            "title": "Preferences",
            "type": "array"
          }
        },
        "required": [
          "preferences"
        ],
        "title": "PreferencesUpdate",
        "type": "object"
      },
      "TransportInfo": {
        "description": "Transport metadata for rendering the control panel.",
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "delegated": {
            "title": "Delegated",
            "type": "boolean"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "requires_client": {
            "title": "Requires Client",
            "type": "boolean"
          },
          "type": {
            "$ref": "#/components/schemas/TransportTypeEnum"
          }
        },
        "required": [
          "type",
          "label",
          "requires_client",
          "delegated",
          "available"
        ],
        "title": "TransportInfo",
        "type": "object"
      },
      "TransportTypeEnum": {
        "description": "Notification delivery transport. Shared by the notify service, producers\nand the frontend (via OpenAPI).",
        "enum": [
          "email",
          "webpush",
          "telegram",
          "mobile",
          "realtime"
        ],
        "title": "TransportTypeEnum",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VapidPublicKey": {
        "properties": {
          "public_key": {
            "title": "Public Key",
            "type": "string"
          }
        },
        "required": [
          "public_key"
        ],
        "title": "VapidPublicKey",
        "type": "object"
      }
    }
  },
  "paths": {
    "/notify/v1/clients/my": {
      "get": {
        "operationId": "list_my_clients_notify_v1_clients_my_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ClientRead"
                  },
                  "title": "Response List My Clients Notify V1 Clients My Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "examples": {
                  "INVALID_AUTHENTICATION_CREDENTIALS": {
                    "summary": "Token decode failed",
                    "value": {
                      "detail": "INVALID_AUTHENTICATION_CREDENTIALS"
                    }
                  },
                  "NOT_AUTHENTICATED": {
                    "summary": "Missing or invalid authentication token",
                    "value": {
                      "detail": "NOT_AUTHENTICATED"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Missing or invalid authentication token"
          },
          "403": {
            "content": {
              "application/json": {
                "examples": {
                  "FORBIDDEN": {
                    "summary": "Not superuser or not verified",
                    "value": {
                      "detail": "FORBIDDEN"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Insufficient permissions"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List My Clients",
        "tags": [
          "notify"
        ]
      },
