    "/geo/v2/map": {
      "get": {
        "description": "Places in a map window, clustered for the zoom.\n\nThe window is cut into cells of `radius_px` screen pixels (Web Mercator,\nso a cell is the same size on screen everywhere) and every cell becomes\none feature: the place itself when it is alone, a cluster otherwise.\nThe answer is bounded by the cells that fit the window, not by how\ndense the data is, so a crowded district cannot push the rest out.\nFrom zoom 17 on nothing is clustered.",
        "operationId": "get_map_geo_v2_map_get",
        "parameters": [
          {
            "description": "west,south,east,north in degrees (RFC 7946 order). West greater than east means a window across the antimeridian.",
            "in": "query",
            "name": "bbox",
            "required": true,
            "schema": {
              "description": "west,south,east,north in degrees (RFC 7946 order). West greater than east means a window across the antimeridian.",
              "examples": [
                "37.3,55.5,37.9,55.9"
              ],
              "title": "Bbox",
              "type": "string"
            }
          },
          {
            "description": "The map's zoom level, fractions allowed.",
            "in": "query",
            "name": "zoom",
            "required": true,
            "schema": {
              "description": "The map's zoom level, fractions allowed.",
              "maximum": 22,
              "minimum": 0,
              "title": "Zoom",
              "type": "number"
            }
          },
          {
            "description": "Screen pixels one marker (or cluster) takes.",
            "in": "query",
            "name": "radius_px",
            "required": false,
            "schema": {
              "default": 64,
              "description": "Screen pixels one marker (or cluster) takes.",
              "maximum": 256,
              "minimum": 24,
              "title": "Radius Px",
