          },
          "401": {
            "content": {
              "application/json": {
                "examples": {
                  "INVALID_AUTHENTICATION_CREDENTIALS": {
                    "summary": "Token decode failed",
                    "value": {
                      "detail": "INVALID_AUTHENTICATION_CREDENTIALS"
                    }
                  },
                  "NOT_AUTHENTICATED": {
                    "summary": "Missing or invalid authentication token",
                    "value": {
                      "detail": "NOT_AUTHENTICATED"
                    }
                  }
                },
