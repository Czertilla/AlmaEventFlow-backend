      "post": {
        "description": "Makes the caller's profile in one transaction and links it to the account.\n\nA user makes one profile for themselves: a second attempt is\n`403 PROFILE_ALREADY_EXISTS`. The access token carries the linked person\nonly after its next refresh; profile endpoints do not depend on it.",
        "operationId": "create_my_profile_profile_v2_profiles_my_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MyProfileWrite"
              }
            }
          },
          "required": true
        },
        "responses": {
